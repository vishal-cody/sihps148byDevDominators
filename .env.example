# ─────────────────────────────────────────────
# JOCKY Platform — Environment Variables
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# ── Application ──────────────────────────────
JOCKY_ENV=development
JOCKY_SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY_MIN_32_CHARS
JOCKY_JWT_ALGORITHM=HS256
JOCKY_JWT_EXPIRE_MINUTES=1440

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://jocky:jocky_pass@localhost:5432/jocky_db
# For local dev without Docker, use SQLite:
# DATABASE_URL=sqlite:///./jocky_dev.db

# ── Redis ─────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Backend ───────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend ──────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000

# ── Agent ─────────────────────────────────────
AGENT_API_URL=http://localhost:8000
AGENT_HEARTBEAT_INTERVAL=30
AGENT_POLL_INTERVAL=10

# ── Seed Data ─────────────────────────────────
SEED_DEMO_DATA=true
SEED_ADMIN_PASSWORD=admin123

# ── Reports ───────────────────────────────────
REPORT_OUTPUT_DIR=./reports_output

# ── Security (NEVER set to true in production unless behind mTLS) ──
ALLOW_UNAUTHENTICATED_AGENTS=false
